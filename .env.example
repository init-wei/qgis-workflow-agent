# PostgreSQL配置（Docker部署）
# 使用docker-compose启动数据库：docker-compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qgis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qgis_db

# OpenAI配置（用于LLM）
# 使用GPT-4o或DeepSeek-Coder等兼容模型
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# QGIS MCP配置
QGIS_MCP_SERVER_URL=http://localhost:8000/mcp

# 文件路径配置
SHARED_ROOT_DIR=./shared

# GDAL文档目录
GDAL_DOCS_DIR=./data/gdal_docs
