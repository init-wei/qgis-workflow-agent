# Copy to .env (chmod 600). Use a random password; never commit .env.
COMPOSE_PROJECT_NAME=qgis-workflow-agent-v1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
POSTGRES_USER=qgis_agent
POSTGRES_PASSWORD=replace_with_random_password
POSTGRES_DB=qgis_workflow
DATABASE_URL=postgresql://qgis_agent:replace_with_random_password@127.0.0.1:55433/qgis_workflow
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL_NAME=deepseek-chat
OPENAI_TEMPERATURE=0.1
QGIS_MCP_SERVER_URL=http://127.0.0.1:8000/mcp
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=9000
SHARED_ROOT_DIR=./shared
GDAL_DOCS_DIR=./data/gdal_docs
# T04 implements/validates optional observation after the real GIS loop.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qgis-workflow-agent-v1
