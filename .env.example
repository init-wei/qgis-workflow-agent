# PostgreSQL配置（Docker部署）
# 使用docker-compose启动数据库：docker-compose up -d
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/qgis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qgis_db

# OpenAI-compatible LLM配置
# DeepSeek示例：
OPENAI_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL_NAME=deepseek-v4-pro
OPENAI_TEMPERATURE=0.1

# QGIS MCP配置
QGIS_MCP_SERVER_URL=http://localhost:8000/mcp

# 文件路径配置
SHARED_ROOT_DIR=./shared

# GDAL文档目录
GDAL_DOCS_DIR=./data/gdal_docs
