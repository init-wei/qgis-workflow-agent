{
  "skill_id": "qwa-reproject",
  "version": "1.0.0",
  "family": "reproject",
  "name": "矢量图层重投影",
  "summary": "按用户指定的适用目标 CRS 生成新文件；示例 CRS 只是参考。",
  "tags": [
    "重投影",
    "reproject"
  ],
  "aliases": [
    "坐标转换",
    "转换坐标系",
    "投影转换",
    "reprojection"
  ],
