      "role": "source",
      "geometry": "vector"
    }
  ],
  "variables": [
    {
      "name": "source_file_id",
      "type": "string",
      "source": "file_id",
      "role": "source"
    },
    {
      "name": "source_path",
      "type": "string",
      "source": "file_path",
      "role": "source"
    },
    {
      "name": "source_layer_name",
      "type": "string",
      "source": "layer_name",
