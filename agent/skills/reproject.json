        "file_id": "${source_file_id}",
        "path": "${source_path}",
        "layer_name": "${source_layer_name}",
        "source": "${source_filename}"
      }
    ],
    "expected_outputs": [
      {
        "output_id": "projected",
        "description": "重投影结果",
        "path": "${output_filename}"
      }
    ],
    "steps": [
      {
        "step_id": 1,
        "description": "重投影",
        "allowed_tools": [
          "execute_processing"
        ],
        "input_refs": [
          "source"
        ],
        "output_refs": [
          "projected"
        ],
        "risk_level": "low",
        "requires_review": false
      }
    ],
    "tool_calls": [
      {
        "step_id": 1,
        "tool_name": "execute_processing",
        "arguments": {
          "algorithm": "native:reprojectlayer",
          "parameters": {
            "INPUT": "${source_path}",
            "TARGET_CRS": "${target_crs}",
            "OUTPUT": "${output_filename}"
          }
        },
        "risk_level": "low",
        "requires_review": false
      }
    ],
    "metadata": {}
